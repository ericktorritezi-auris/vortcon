{
  "name": "vortcon",
  "version": "1.0.0",
  "private": true,
  "description": "VortCon \u2014 Entenda seu dinheiro. Assuma o controle. SaaS de organiza\u00e7\u00e3o e controle financeiro pessoal. Desenvolvido por Belle Planner.",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npm run db:migrate:deploy && next start",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "worker": "tsx src/worker/index.ts",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "healthcheck": "tsx scripts/healthcheck.ts",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.0",
    "@prisma/client": "^5.20.0",
    "lucide-react": "^0.445.0",
    "next": "^14.2.0",
    "prisma": "^5.20.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "resend": "6.26.0",
    "sanitize-html": "2.17.7",
    "tsx": "^4.19.0",
    "zod": "^3.23.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/sanitize-html": "2.16.1",
    "@typescript-eslint/eslint-plugin": "8.69.0",
    "@typescript-eslint/parser": "8.69.0",
    "autoprefixer": "^10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.35",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.6",
    "postcss": "^8.4.47",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.6.14",
    "tailwindcss": "^3.4.10",
    "typescript": "5.9.3",
    "vitest": "^2.1.0"
  }
}

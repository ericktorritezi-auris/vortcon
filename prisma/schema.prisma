// VortCon — schema.prisma
// Fonte transacional de verdade: PostgreSQL, com foreign keys, constraints e migrations
// versionadas (Master Document, Seção 35). Nunca usar FLOAT/DOUBLE para dinheiro (Seção 36).
//
// Este arquivo é a fundação do Estágio 1. As entidades de domínio (users, tenants,
// financial_accounts, categories, tags, financial_transactions, etc. — Seção 38)
// são introduzidas nos Estágios 3 (Multitenancy) e 7 (Domínio Financeiro), para que
// cada modelo chegue já acompanhado de suas migrations, repositórios e testes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Healthcheck mínimo para validar conectividade em CI/deploy (Seção 159).
// Pode ser removido assim que houver uma entidade real para essa finalidade.
model SystemHealth {
  id        String   @id @default(cuid())
  checkedAt DateTime @default(now())

  @@map("system_health")
}

// ─────────────────────────────────────────────────────────────────────────
// ESTÁGIO 3 — MULTITENANCY (Seções 19-24, 30-31, 38)
//
// Modelo estrutural: Tenant → TenantUser → User. Mesmo que a V1 tenha
// essencialmente um OWNER por tenant, User NUNCA é acoplado a Tenant
// diretamente — TenantUser existe para permitir evolução futura para
// multiusuário sem migração destrutiva (Seção 19).
//
// GLOBAL_ADMIN não é membro de nenhum tenant (Seção 22: "Admin separado dos
// ambientes financeiros") — por isso o papel vive em User.role, não em
// TenantUser. GLOBAL_ADMIN.canAccessFinancialData = false é aplicado em
// código (ver src/shared/security/roles.ts), não no banco.
// ─────────────────────────────────────────────────────────────────────────

enum Role {
  GLOBAL_ADMIN
  TENANT_OWNER
}

enum TenantLifecycle {
  ACTIVE
  INACTIVE
}

// Bloqueios são uma dimensão separada do lifecycle (Seção 30) — um tenant
// ACTIVE pode estar bloqueado por inadimplência sem deixar de existir.
enum TenantBlockType {
  DELINQUENCY
  ADMINISTRATIVE
  SECURITY
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  birthDate    DateTime? @db.Date
  username     String   @unique
  timezone     String   @default("America/Sao_Paulo")
  role         Role     @default(TENANT_OWNER)
  // Definida pelo próprio usuário no fluxo de ativação (Seção 25-26) — nunca
  // preenchida pelo Admin. Nula até a ativação. Hashing (Argon2id) é
  // responsabilidade do módulo `auth` (Estágio 4), não deste modelo.
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenantMemberships   TenantUser[]
  sessions            Session[]
  invitations         UserInvitation[]
  passwordResetTokens PasswordResetToken[]
  legalAcceptances    LegalAcceptance[]

  @@map("users")
}

model Tenant {
  id        String          @id @default(cuid())
  lifecycle TenantLifecycle @default(ACTIVE)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  memberships          TenantUser[]
  accessBlocks         TenantAccessBlock[]
  legalAcceptances     LegalAcceptance[]
  subscription         TenantSubscription?
  financialAccounts    FinancialAccount[]
  categories           Category[]
  tags                 Tag[]
  financialTransactions FinancialTransaction[]
  transfers            Transfer[]
  recurrenceSeries     RecurrenceSeries[]

  @@map("tenants")
}

model TenantUser {
  id        String   @id @default(cuid())
  tenantId  String
  // Único por usuário (não por par tenantId+userId): em V1, um usuário
  // pertence a no máximo um tenant. A coluna vem antes de tenantId para que
  // o índice único sirva também como verificação rápida de ownership
  // (Seção 210) ao resolver "a qual tenant este usuário pertence".
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@map("tenant_users")
}

// Registro append-only de bloqueios (Seção 30-31, 114). Um bloqueio nunca é
// apagado ao ser levantado — `active=false` preserva histórico auditável.
model TenantAccessBlock {
  id        String          @id @default(cuid())
  tenantId  String
  type      TenantBlockType
  active    Boolean         @default(true)
  reason    String?
  createdAt DateTime        @default(now())
  liftedAt  DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, type, active])
  @@map("tenant_access_blocks")
}

// ─────────────────────────────────────────────────────────────────────────
// ESTÁGIO 5 — LEGAL (Seções 129-137)
// ─────────────────────────────────────────────────────────────────────────

enum LegalDocumentType {
  PRIVACY_POLICY
  TERMS_OF_USE
}

enum LegalDocumentVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// Um "documento" é o conceito estável (ex.: "nossa Política de Privacidade");
// o conteúdo de verdade vive em `LegalDocumentVersion` (Seção 131).
model LegalDocument {
  id        String            @id @default(cuid())
  type      LegalDocumentType @unique
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  versions LegalDocumentVersion[]

  @@map("legal_documents")
}

// Versão publicada é imutável (Seção 131) — qualquer alteração de conteúdo
// depois de PUBLISHED cria uma nova versão DRAFT, nunca edita esta linha.
model LegalDocumentVersion {
  id         String                     @id @default(cuid())
  documentId String
  version    Int
  status     LegalDocumentVersionStatus @default(DRAFT)
  // HTML já sanitizado no momento da escrita (Seção 130) — nunca confiar em
  // sanitização só no client.
  contentHtml String
  // Seção 132: "Admin define: Exigir novo aceite?" — só tem efeito relevante
  // em versões PUBLISHED; controla se aceites de versões anteriores deste
  // documento deixam de contar (gate exige novo aceite desta versão).
  requiresReacceptance Boolean   @default(true)
  publishedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  document    LegalDocument      @relation(fields: [documentId], references: [id], onDelete: Restrict)
  acceptances LegalAcceptance[]

  @@unique([documentId, version])
  @@index([documentId, status])
  @@map("legal_document_versions")
}

// Evidência de aceite (Seção 133) — nunca um booleano solto tipo
// `lgpd_accepted = true`. Guarda quem, o quê, quando e com que evidência.
model LegalAcceptance {
  id                String   @id @default(cuid())
  tenantId          String
  userId            String
  documentVersionId String
  acceptedAt        DateTime @default(now())
  ipAddress         String?
  userAgent         String?

  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user            User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  documentVersion LegalDocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Restrict)

  @@unique([userId, documentVersionId])
  @@index([tenantId])
  @@map("legal_acceptances")
}
//
// Nenhum token de uso único (convite, redefinição de senha) é armazenado em
// texto puro — só o hash SHA-256 do token (Seção 26 é sobre senha, mas o
// mesmo princípio de "nunca guardar segredo recuperável" se aplica aqui: o
// valor real só existe no link enviado por e-mail, nunca no banco).
// ─────────────────────────────────────────────────────────────────────────

// Sessão server-side (Seção 28). O cookie guarda o token bruto; o banco
// guarda só o hash — comprometer o banco não permite sequestrar sessões.
model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// Convite de ativação (Seção 25). Uso único (`usedAt`), com expiração.
// Admin nunca conhece a senha — só o convite existe até o usuário definir a
// própria senha em `/convite/[token]`.
model UserInvitation {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_invitations")
}

// Recuperação de senha (Seção 27). Mesmo padrão de uso único + expiração
// curta do convite.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ─────────────────────────────────────────────────────────────────────────
// ESTÁGIO 6 — ADMIN/COMERCIAL (Seções 22-24, 102-115, 146-148, 162)
// ─────────────────────────────────────────────────────────────────────────

enum PlanPeriodicity {
  MONTHLY
}

// Planos não são tiers de feature (Seção 105) — só catálogo comercial.
// Histórico impede hard delete quando já usado (Seção 102): inativar, nunca
// apagar um plano referenciado por alguma assinatura.
model SubscriptionPlan {
  id          String          @id @default(cuid())
  name        String
  priceCents  Int
  periodicity PlanPeriodicity @default(MONTHLY)
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  subscriptions TenantSubscription[]

  @@map("subscription_plans")
}

enum SubscriptionCondition {
  PAID
  EXEMPT
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
}

// Separado de `SubscriptionPlan` de propósito (Seção 106): o preço
// contratado é congelado aqui no momento da criação — mudar o preço do
// plano no catálogo nunca altera contratos já existentes (Seção 107).
model TenantSubscription {
  id                   String                @id @default(cuid())
  tenantId             String                @unique
  planId               String
  contractedPriceCents Int
  condition            SubscriptionCondition @default(PAID)
  status                SubscriptionStatus    @default(ACTIVE)
  // Dia do mês de vencimento (Seção 113 usa dia 10 como exemplo). 1-28 para
  // nunca cair em dia inexistente em fevereiro.
  dueDay                Int                   @default(10)
  createdAt             DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  tenant  Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  plan    SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)
  charges SubscriptionCharge[]

  @@map("tenant_subscriptions")
}

enum ChargeStatus {
  PENDING
  PAID
}

// A "mensalidade" (Seção 109). Pagamento é sempre registrado pelo Admin
// (PIX externo, Seção 110) — o tenant nunca marca a própria cobrança como
// paga. OVERDUE é derivado (dueDate no passado + status ainda PENDING),
// nunca um status próprio — mesmo padrão de financial_transactions.
model SubscriptionCharge {
  id             String       @id @default(cuid())
  subscriptionId String
  tenantId       String
  // Competência (mês de referência), armazenada como o primeiro dia do mês.
  competence     DateTime     @db.Date
  amountCents    Int
  dueDate        DateTime     @db.Date
  status         ChargeStatus @default(PENDING)
  paidAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  subscription TenantSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@unique([subscriptionId, competence])
  @@index([tenantId, status])
  @@map("subscription_charges")
}

enum AuditActorType {
  GLOBAL_ADMIN
  TENANT_OWNER
  SYSTEM
}

enum AuditVisibility {
  ADMIN
  INTERNAL
}

// Trilha de auditoria (Seção 146). `metadataSanitized` nunca contém valor,
// descrição, categoria, tag, nota ou saldo (Seção 147) — quem grava o
// evento é responsável por só incluir metadados seguros; este modelo não
// tem como validar isso automaticamente, é uma disciplina de quem chama
// `recordAuditEvent()`.
model AuditEvent {
  id                String           @id @default(cuid())
  actorType         AuditActorType
  actorId           String?
  tenantId          String?
  eventType         String
  entityType        String
  entityId          String?
  visibility        AuditVisibility  @default(ADMIN)
  metadataSanitized Json?
  createdAt         DateTime         @default(now())

  @@index([tenantId, createdAt])
  @@index([eventType])
  @@map("audit_events")
}

// ─────────────────────────────────────────────────────────────────────────
// ESTÁGIO 7 — DOMÍNIO FINANCEIRO (Seções 38-70, 202-204, 225)
//
// Regra estrutural inegociável (Seção 225, reforçada com redundância de
// propósito no documento original): Category e Tag NUNCA têm campo `type`.
// A natureza financeira (entrada/saída) pertence exclusivamente a
// `FinancialTransaction.type`. Uma mesma categoria/tag pode aparecer em
// receitas E despesas simultaneamente — isso é o comportamento correto,
// não um bug. Relatórios "completos" mostram os dois lados + resultado
// líquido; filtrar por natureza filtra a TRANSAÇÃO, nunca a categoria/tag.
//
// `recurrenceSeriesId`/`recurrenceOccurrenceKey` (Seção 54) ficam de fora
// deste estágio de propósito — `recurrence_series` só existe no Estágio 8;
// adicionar a coluna agora exigiria uma FK para uma tabela inexistente.
// ─────────────────────────────────────────────────────────────────────────

enum FinancialAccountType {
  CHECKING
  SAVINGS
  CASH
  OTHER
}

// Conta representa onde o dinheiro está (Seção 39). Saldo nunca é uma
// coluna mutável — é sempre derivado (Seção 40): saldo inicial + receitas
// recebidas - despesas pagas ± transferências concluídas.
model FinancialAccount {
  id                  String               @id @default(cuid())
  tenantId            String
  name                String
  type                FinancialAccountType @default(CHECKING)
  initialBalanceCents Int
  initialBalanceDate  DateTime             @db.Date
  active              Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  tenant             Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  transactions       FinancialTransaction[]
  transfersOut       Transfer[]             @relation("TransferSource")
  transfersIn        Transfer[]             @relation("TransferDestination")

  @@index([tenantId])
  @@map("financial_accounts")
}

// Categoria global e transversal ao tenant (Seção 41-42). SEM campo de
// natureza financeira — ver aviso no topo desta seção do schema.
model Category {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  iconKey   String   @default("wallet")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  transactions FinancialTransaction[]

  @@index([tenantId])
  @@map("categories")
}

// Tag global e transversal ao tenant (Seção 51-52). Mesma regra da
// categoria: sem natureza financeira própria.
model Tag {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant          Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  transactionTags FinancialTransactionTag[]

  @@index([tenantId])
  @@map("tags")
}

enum FinancialTransactionType {
  EXPENSE
  INCOME
}

enum FinancialTransactionStatus {
  PENDING
  PAID
  RECEIVED
  CANCELLED
}

// Entidade unificada para receitas e despesas (Seção 54). A natureza
// financeira vive exclusivamente em `type` — nunca em categoria/tag.
model FinancialTransaction {
  id                  String                      @id @default(cuid())
  tenantId            String
  type                FinancialTransactionType
  description         String
  amountCents         Int
  dueDate             DateTime                    @db.Date
  settlementDate      DateTime?                   @db.Date
  status              FinancialTransactionStatus  @default(PENDING)
  accountId           String
  categoryId          String?
  reminderEnabled     Boolean                     @default(false)
  ignored             Boolean                     @default(false)
  note                String?
  cancelledAt         DateTime?
  cancelledFromStatus FinancialTransactionStatus?
  // Vínculo com a série (Seção 71) — ambos nulos para lançamentos avulsos.
  // A unicidade em [recurrenceSeriesId, recurrenceOccurrenceKey] impede
  // duplicação de ocorrência (Seção 71: "Impedir duplicação").
  recurrenceSeriesId       String?
  recurrenceOccurrenceKey  String?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  tenant           Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  account          FinancialAccount          @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category         Category?                 @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags             FinancialTransactionTag[]
  recurrenceSeries RecurrenceSeries?         @relation(fields: [recurrenceSeriesId], references: [id], onDelete: SetNull)

  @@unique([recurrenceSeriesId, recurrenceOccurrenceKey])
  @@index([tenantId, status])
  @@index([tenantId, dueDate])
  @@index([tenantId, createdAt])
  @@index([tenantId, accountId])
  @@index([tenantId, categoryId, dueDate])
  @@map("financial_transactions")
}

// Associação transação↔tag (Seção 55). Tag e transação devem pertencer ao
// mesmo tenant — validado em código (ownership, Seção 210), não pelo schema.
model FinancialTransactionTag {
  transactionId String
  tagId         String

  transaction FinancialTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  tag         Tag                  @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@id([transactionId, tagId])
  @@map("financial_transaction_tags")
}

enum TransferStatus {
  PENDING
  COMPLETED
  CANCELLED
}

// Transferência entre contas (Seção 66) — entidade própria, nunca distorce
// resultado (não é receita nem despesa). Pendente não altera saldo real
// (Seção 67); concluída diminui origem e aumenta destino atomicamente.
model Transfer {
  id                   String         @id @default(cuid())
  tenantId             String
  sourceAccountId      String
  destinationAccountId String
  amountCents          Int
  scheduledDate        DateTime       @db.Date
  settlementDate       DateTime?      @db.Date
  status               TransferStatus @default(PENDING)
  note                 String?
  cancelledAt          DateTime?
  // Seção 66 — transferência recorrente (ex.: aporte mensal automático entre
  // contas). Nulo para transferências avulsas. Adicionado só agora porque
  // `recurrence_series` não existia antes do Estágio 8.
  recurrenceSeriesId   String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sourceAccount      FinancialAccount  @relation("TransferSource", fields: [sourceAccountId], references: [id], onDelete: Restrict)
  destinationAccount FinancialAccount  @relation("TransferDestination", fields: [destinationAccountId], references: [id], onDelete: Restrict)
  recurrenceSeries   RecurrenceSeries? @relation(fields: [recurrenceSeriesId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@map("transfers")
}

// ─────────────────────────────────────────────────────────────────────────
// ESTÁGIO 8 — RECORRÊNCIAS (Seções 69-75)
//
// "Fixa" significa obrigação/receita recorrente — NÃO significa valor
// imutável (Seção 69). Três conceitos sempre separados: série (o padrão),
// ocorrência (uma instância materializada como FinancialTransaction) e
// liquidação (o pagamento/recebimento daquela ocorrência).
// ─────────────────────────────────────────────────────────────────────────

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
  CUSTOM_DAYS
}

// A série é só o padrão gerador (Seção 70) — nunca a fonte de verdade do
// valor/vencimento de uma ocorrência já materializada e editada
// individualmente (Seção 72). `defaultCategoryId` referencia categoria
// global, sem tipo (Seção 70) — mesma regra estrutural do Estágio 7.
model RecurrenceSeries {
  id                      String                   @id @default(cuid())
  tenantId                String
  transactionType         FinancialTransactionType
  frequency               RecurrenceFrequency
  interval                Int                      @default(1)
  startDate               DateTime                 @db.Date
  endDate                 DateTime?                @db.Date
  maxOccurrences          Int?
  baseAmountCents         Int
  // Reservado para regras de vencimento mais elaboradas no futuro (ex.:
  // "último dia útil do mês"). Na V1, a materialização deriva a data de
  // cada ocorrência a partir de `startDate` + `frequency` + `interval` —
  // a solução mais simples que preserva o requisito (Seção 0).
  baseDueRule             Json?
  defaultAccountId        String
  defaultCategoryId       String?
  defaultReminderEnabled  Boolean                  @default(false)
  active                  Boolean                  @default(true)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  tenant       Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  occurrences  FinancialTransaction[]
  transfers    Transfer[]

  @@index([tenantId, active])
  @@map("recurrence_series")
}

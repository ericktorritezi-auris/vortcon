// VortCon — schema.prisma
// Fonte transacional de verdade: PostgreSQL, com foreign keys, constraints e migrations
// versionadas (Master Document, Seção 35). Nunca usar FLOAT/DOUBLE para dinheiro (Seção 36).
//
// Este arquivo é a fundação do Estágio 1. As entidades de domínio (users, tenants,
// financial_accounts, categories, tags, financial_transactions, etc. — Seção 38)
// são introduzidas nos Estágios 3 (Multitenancy) e 7 (Domínio Financeiro), para que
// cada modelo chegue já acompanhado de suas migrations, repositórios e testes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Healthcheck mínimo para validar conectividade em CI/deploy (Seção 159).
// Pode ser removido assim que houver uma entidade real para essa finalidade.
model SystemHealth {
  id        String   @id @default(cuid())
  checkedAt DateTime @default(now())

  @@map("system_health")
}

// ─────────────────────────────────────────────────────────────────────────
// ESTÁGIO 3 — MULTITENANCY (Seções 19-24, 30-31, 38)
//
// Modelo estrutural: Tenant → TenantUser → User. Mesmo que a V1 tenha
// essencialmente um OWNER por tenant, User NUNCA é acoplado a Tenant
// diretamente — TenantUser existe para permitir evolução futura para
// multiusuário sem migração destrutiva (Seção 19).
//
// GLOBAL_ADMIN não é membro de nenhum tenant (Seção 22: "Admin separado dos
// ambientes financeiros") — por isso o papel vive em User.role, não em
// TenantUser. GLOBAL_ADMIN.canAccessFinancialData = false é aplicado em
// código (ver src/shared/security/roles.ts), não no banco.
// ─────────────────────────────────────────────────────────────────────────

enum Role {
  GLOBAL_ADMIN
  TENANT_OWNER
}

enum TenantLifecycle {
  ACTIVE
  INACTIVE
}

// Bloqueios são uma dimensão separada do lifecycle (Seção 30) — um tenant
// ACTIVE pode estar bloqueado por inadimplência sem deixar de existir.
enum TenantBlockType {
  DELINQUENCY
  ADMINISTRATIVE
  SECURITY
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  birthDate    DateTime? @db.Date
  username     String   @unique
  timezone     String   @default("America/Sao_Paulo")
  role         Role     @default(TENANT_OWNER)
  // Definida pelo próprio usuário no fluxo de ativação (Seção 25-26) — nunca
  // preenchida pelo Admin. Nula até a ativação. Hashing (Argon2id) é
  // responsabilidade do módulo `auth` (Estágio 4), não deste modelo.
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenantMemberships   TenantUser[]
  sessions            Session[]
  invitations         UserInvitation[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model Tenant {
  id        String          @id @default(cuid())
  lifecycle TenantLifecycle @default(ACTIVE)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  memberships TenantUser[]
  accessBlocks TenantAccessBlock[]

  @@map("tenants")
}

model TenantUser {
  id        String   @id @default(cuid())
  tenantId  String
  // Único por usuário (não por par tenantId+userId): em V1, um usuário
  // pertence a no máximo um tenant. A coluna vem antes de tenantId para que
  // o índice único sirva também como verificação rápida de ownership
  // (Seção 210) ao resolver "a qual tenant este usuário pertence".
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@map("tenant_users")
}

// Registro append-only de bloqueios (Seção 30-31, 114). Um bloqueio nunca é
// apagado ao ser levantado — `active=false` preserva histórico auditável.
model TenantAccessBlock {
  id        String          @id @default(cuid())
  tenantId  String
  type      TenantBlockType
  active    Boolean         @default(true)
  reason    String?
  createdAt DateTime        @default(now())
  liftedAt  DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, type, active])
  @@map("tenant_access_blocks")
}

// ─────────────────────────────────────────────────────────────────────────
// ESTÁGIO 4 — AUTH (Seções 18, 25-29, 38)
//
// Nenhum token de uso único (convite, redefinição de senha) é armazenado em
// texto puro — só o hash SHA-256 do token (Seção 26 é sobre senha, mas o
// mesmo princípio de "nunca guardar segredo recuperável" se aplica aqui: o
// valor real só existe no link enviado por e-mail, nunca no banco).
// ─────────────────────────────────────────────────────────────────────────

// Sessão server-side (Seção 28). O cookie guarda o token bruto; o banco
// guarda só o hash — comprometer o banco não permite sequestrar sessões.
model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// Convite de ativação (Seção 25). Uso único (`usedAt`), com expiração.
// Admin nunca conhece a senha — só o convite existe até o usuário definir a
// própria senha em `/convite/[token]`.
model UserInvitation {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_invitations")
}

// Recuperação de senha (Seção 27). Mesmo padrão de uso único + expiração
// curta do convite.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}
